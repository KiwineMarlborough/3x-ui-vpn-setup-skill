# Copy to .env.local — NEVER commit .env.local

# SSH
SSH_HOST=203.0.113.10
SSH_USER=deploy
SSH_KEY_PATH=~/.ssh/vps_ed25519

# Your own public IPs that must NEVER be blocked (IPsum whitelist + Fail2Ban ignoreip). REQUIRED for hardening.
ADMIN_IPS=198.51.100.7

# Domains. The VPN needs ONE public name (CDN). The panel name is NOT created in public DNS by default.
CDN_DOMAIN=cdn.vpn.example.com
PANEL_DOMAIN=panel.vpn.example.com        # only resolves on the admin PC (hosts entry) when PANEL_ACCESS=tunnel
PANEL_ACCESS=tunnel                       # tunnel (default) | public
PANEL_PORT=29800

# 3X-UI (filled after install)
WEB_BASE_PATH=
PANEL_TOKEN=
PANEL_PASSWORD=

# VPN design
COUNTRY_LABEL=DE
REALITY_SNI=pixelforge.pics
HAPP_ROUTING_TEMPLATE=templates/happ-routing-profile-ru.json
HAPP_ROUTING_NAME=SplitRU

# Subscription (filled after client create)
SUB_ID=
SUB_PATH=/xK9mP2qR/
JSON_PATH=/zP4mQ8vN2c/

# API curl resolve (when webDomain is set)
PANEL_RESOLVE=panel.vpn.example.com:29800:127.0.0.1

# Hardening (references/blocklist-ipsum-fail2ban.md)
ENABLE_IPSUM=1                            # verify-server.sh fails if the IPsum table is missing; 0 only if deliberately skipped
IPSUM_MIN_LEVEL=3                         # 2 ~32k addresses, 3 ~17k (recommended), 4 ~9k

# Certificates (scripts/deploy-acme-renewal.sh)
WEBROOT=/var/www/cdn-fallback
ACME_HOME=/root/.acme.sh

# Optional AmneziaWG 3.1 module (references/amneziawg.md)
ENABLE_AWG=0
AWG_PORT=56100
AWG_SUBNET=10.66.66.0/24
AWG_DNS=1.1.1.1,8.8.8.8
AWG_CLIENTS=router,phone
AWG_REMARK=DE-AWG-3.1
